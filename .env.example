# Vorlage für die Konfiguration. Echte Werte nur in der .env auf dem Server, nie im Repository.

APP_NAME="Terminbuchung"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://termine.example.local
APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE
APP_TIMEZONE=Europe/Berlin

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Datenbank: MariaDB 10.11 oder 11.4, eigener Benutzer mit Rechten nur auf diese Datenbank
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=terminvorschlag
DB_USERNAME=terminvorschlag
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=false

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Zugriff: Hausnetz (CIDR, kommagetrennt) und HTTPS-Pflicht
TERMIN_ALLOWED_NETWORKS=
TERMIN_FORCE_HTTPS=true

# Entwicklung: nur mit APP_ENV=local wirksam, sonst ignoriert
TERMIN_DEV_USER=

# Active Directory (LDAPS, Dienstkonto nur mit Leserechten). „static“ ist in Produktion gesperrt.
DIRECTORY_DRIVER=ldap
LDAP_URI=ldaps://ad.example.local:636
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=DC=example,DC=local
LDAP_TLS_CA_FILE=
LDAP_CACHE_TTL=300
LDAP_GROUP_ORGANIZER=
LDAP_GROUP_ADMIN=

# Löschfristen
TERMIN_AUDIT_RETENTION_DAYS=365
TERMIN_PURGE_GRACE_HOURS=0

# E-Mail über den Exchange-Server (Funktionspostfach)
MAIL_MAILER=smtp
MAIL_HOST=exchange.example.local
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=termine@example.de
MAIL_FROM_NAME="${APP_NAME}"
