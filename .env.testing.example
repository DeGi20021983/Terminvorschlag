# Vorlage für die Testumgebung. Kopieren nach .env.testing und die Werte eintragen.
# Die Datei .env.testing ist nicht im Repository. Die Tests brauchen eine eigene, leere Datenbank.
APP_ENV=testing
APP_KEY=
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=terminvorschlag_test
DB_USERNAME=
DB_PASSWORD=
